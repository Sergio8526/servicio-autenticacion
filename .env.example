# Copia este archivo como .env y completa tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto del servicio (4000 para no chocar con Baby Saraí, que usa el 3000)
PORT=4000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=servicio_autenticacion

# Secreto para firmar los tokens JWT. Usa un texto largo y aleatorio.
# Puedes generar uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRETO=cambia_este_texto_por_uno_largo_y_aleatorio

# Duración del token: 15m, 1h, 7d...
JWT_EXPIRA=1h

# Rondas de bcrypt (10 es el valor recomendado)
BCRYPT_RONDAS=10
